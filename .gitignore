# Ignore everything
*

# Keep directories (including dot-directories) so Git can traverse
!*/
!.*/

# Allow Python and shell scripts anywhere
!**/*.py
!**/*.sh
!**/*.urdf
!**/*.xml
!**/*.obj

# Keep these
!.gitignore
!README*
!skills/**/SKILL.md
!skills/**/agents/openai.yaml
!LICENSE*
!src/holosoma_inference/docs/workflows/sim2sim.md

# Local training / dataset payloads (always ignore)
data/
data/**
!data_demo/
!data_demo/**
/multi-terrain/staged/
/multi-terrain/staged/**
/multi-terrain/generated/terrain_generalist_*_*.obj
/multi-terrain/generated/terrain_generalist_*_*.json
/outputs/debug_as_replay_record/

# Local CRISP data packages (always ignore)
crisp/
crisp/**
multi-terrain/generated/*.obj
