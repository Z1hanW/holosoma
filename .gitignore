# Ignore everything
*

# Keep directories (including dot-directories) so Git can traverse
!*/
!.*/

# Allow Python and shell scripts anywhere
!**/*.py
!**/*.sh
!**/*.urdf
!**/*.xml
!**/*.obj

# Keep these
!.gitignore
!README*
!skills/**/SKILL.md
!skills/**/agents/openai.yaml
!LICENSE*
!src/holosoma_inference/docs/workflows/sim2sim.md

# Local CRISP data packages (always ignore)
crisp/
crisp/**
